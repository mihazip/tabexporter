{
  "manifest_version": 3,
  "name": "TabExporter",
  "version": "0.1.4",
  "description": "Export tabs from Firefox Android",
  "permissions": [
    "tabs",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export Tabs"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabexporter@miha.zip",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://github.com/mihazip/tabexporter/releases/latest/download/updates.json"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
